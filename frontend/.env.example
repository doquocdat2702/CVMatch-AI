VITE_API_URL=http://localhost:5000/api
# Tên hệ thống: Header, trang đăng nhập, trang chủ và <title> của index.html.
# Bắt buộc khai báo trong .env: thiếu thì <title> hiện nguyên chữ %VITE_APP_NAME%
VITE_APP_NAME=Tuyển dụng DMatch
# Trang Liên hệ (/contact): email mở bằng mailto:, số điện thoại mở bằng tel:.
# Để trống thì trang ẩn dòng đó
VITE_CONTACT_EMAIL=tuyendung@congty.vn
VITE_CONTACT_PHONE=028 1234 5678
# Footer: link chữ "Facebook", "YouTube" (mở tab mới), ghi đầy đủ https://.
# Để trống thì ẩn link đó, trống cả hai thì ẩn dòng "Theo dõi chúng tôi"
VITE_FACEBOOK_URL=https://www.facebook.com/congty
VITE_YOUTUBE_URL=https://www.youtube.com/@congty
