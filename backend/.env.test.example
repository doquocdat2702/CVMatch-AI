NODE_ENV="development"
PORT=5001
DATABASE_URL="mysql://root:password@localhost:3306/cv_matching_test"
# Ít nhất 32 ký tự, tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"
JWT_EXPIRES_IN="1d"
UPLOAD_DIR="uploads"
# Thời gian tối đa (ms) trích xuất text một file CV, quá thì CV chuyển FAILED; không đặt thì 15000
EXTRACT_TIMEOUT_MS=15000
ADMIN_EMAIL="admin@cvmatch.local"
ADMIN_PASSWORD="Admin@12345"
COMPANY_NAME="Công ty TNHH CVMatch"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Chế độ phân tích CV / JD: hybrid = rule + Gemini (mặc định), rule = chỉ rule, không gọi Gemini
NLP_MODE=rule
MAIL_USER="tai-khoan-gui-thu@gmail.com"
MAIL_APP_PASSWORD="abcd efgh ijkl mnop"
MAIL_FROM_NAME="CVMatch Tuyển dụng"
FRONTEND_URL="http://localhost:5173"
# Origin frontend được gọi API, nhiều origin cách nhau bởi dấu phẩy
CORS_ORIGIN="http://localhost:5173"
