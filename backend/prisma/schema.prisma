// Prisma schema cho CVMatch-AI
// Phần 1: enum + nhóm model User / Company / Profile

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== ENUM =====

enum CvStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum RequirementType {
  REQUIRED
  PREFERRED
  OPTIONAL
}

enum MatchStatus {
  SUPPORTED
  UNCERTAIN
  NOT_FOUND
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  ACCEPTED
  REJECTED
}

// ===== MODEL =====

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(191) // ADMIN | CANDIDATE | RECRUITER
  description String? @db.VarChar(255)

  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  isActive  Boolean  @default(true)
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role             Role              @relation(fields: [roleId], references: [id])
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?

  @@index([roleId])
}

model Company {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String? @db.Text
  address     String? @db.VarChar(255)
  website     String? @db.VarChar(255)

  recruiters RecruiterProfile[]
  jobs       Job[]
}

model RecruiterProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  fullName  String  @db.VarChar(255)
  phone     String? @db.VarChar(50)
  position  String? @db.VarChar(255)
  companyId Int

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  jobs    Job[]

  @@index([companyId])
}

model CandidateProfile {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  fullName String  @db.VarChar(255)
  phone    String? @db.VarChar(50)
  address  String? @db.VarChar(255)
  headline String? @db.VarChar(255)

  user         User                  @relation(fields: [userId], references: [id])
  cvs          CV[]
  skills       CandidateSkill[]
  experiences  CandidateExperience[]
  educations   CandidateEducation[]
  applications Application[]
}

model CV {
  id                 Int       @id @default(autoincrement())
  candidateProfileId Int
  fileName           String    @db.VarChar(255)
  filePath           String    @db.VarChar(500)
  fileType           String    @db.VarChar(10) // PDF | DOCX
  rawText            String?   @db.LongText
  status             CvStatus  @default(UPLOADED)
  errorMessage       String?   @db.Text
  uploadedAt         DateTime  @default(now())
  parsedAt           DateTime?

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])

  @@index([candidateProfileId])
}

model Skill {
  id      Int    @id @default(autoincrement())
  name    String @unique @db.VarChar(191) // tên đã chuẩn hóa
  aliases String @db.Text // các alias cách nhau bởi dấu phẩy

  candidateSkills CandidateSkill[]
  jobRequirements JobRequirement[]
}

model CandidateSkill {
  id                 Int     @id @default(autoincrement())
  candidateProfileId Int
  skillId            Int?
  rawName            String  @db.VarChar(255) // tên kỹ năng như xuất hiện trong CV
  evidence           String? @db.Text
  source             String  @db.VarChar(20) // RULE | NLP | MANUAL
  isConfirmed        Boolean @default(false)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  skill            Skill?           @relation(fields: [skillId], references: [id])

  @@index([candidateProfileId])
  @@index([skillId])
}

model CandidateExperience {
  id                 Int       @id @default(autoincrement())
  candidateProfileId Int
  position           String    @db.VarChar(255)
  companyName        String    @db.VarChar(255)
  startDate          DateTime?
  endDate            DateTime?
  description        String?   @db.Text
  evidence           String?   @db.Text
  source             String    @db.VarChar(20) // RULE | NLP | MANUAL
  isConfirmed        Boolean   @default(false)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])

  @@index([candidateProfileId])
}

model CandidateEducation {
  id                 Int       @id @default(autoincrement())
  candidateProfileId Int
  school             String    @db.VarChar(255)
  major              String    @db.VarChar(255)
  degree             String    @db.VarChar(255)
  startDate          DateTime?
  endDate            DateTime?
  source             String    @db.VarChar(20) // RULE | NLP | MANUAL
  isConfirmed        Boolean   @default(false)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])

  @@index([candidateProfileId])
}

model Job {
  id                 Int      @id @default(autoincrement())
  title              String   @db.VarChar(255)
  description        String   @db.LongText // JD gốc
  location           String?  @db.VarChar(255)
  isOpen             Boolean  @default(true)
  companyId          Int
  recruiterProfileId Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  recruiterProfile RecruiterProfile @relation(fields: [recruiterProfileId], references: [id])
  requirements     JobRequirement[]
  applications     Application[]

  @@index([companyId])
  @@index([recruiterProfileId])
}

model JobRequirement {
  id             Int             @id @default(autoincrement())
  jobId          Int
  rawText        String          @db.Text // câu gốc trong JD
  normalizedName String          @db.VarChar(255)
  skillId        Int?
  type           RequirementType
  minYears       Int?

  job   Job    @relation(fields: [jobId], references: [id])
  skill Skill? @relation(fields: [skillId], references: [id])

  @@index([jobId])
  @@index([skillId])
}

model Application {
  id                 Int               @id @default(autoincrement())
  candidateProfileId Int
  jobId              Int
  status             ApplicationStatus @default(APPLIED)
  coverage           Float?
  appliedAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  job              Job              @relation(fields: [jobId], references: [id])

  @@unique([candidateProfileId, jobId])
  @@index([jobId])
}
