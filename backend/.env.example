NODE_ENV="development"
PORT=5000
DATABASE_URL="mysql://root:password@localhost:3306/cvmatch"
# Ít nhất 32 ký tự, tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"
JWT_EXPIRES_IN="1d"
UPLOAD_DIR="uploads"
# Thời gian tối đa (ms) trích xuất text một file CV, quá thì CV chuyển FAILED; không đặt thì 15000
EXTRACT_TIMEOUT_MS=15000
ADMIN_EMAIL="admin@cvmatch.local"
ADMIN_PASSWORD="doi-mat-khau-mac-dinh"
# Bắt buộc: tên công ty duy nhất của hệ thống (tối đa 255 ký tự). Thiếu hoặc rỗng thì server không khởi động.
# Mỗi lần khởi động, server tự tạo công ty nếu chưa có, đổi tên theo biến này (id giữ nguyên) và gán HR chưa có công ty.
# HR không sửa được tên trên giao diện: muốn đổi tên thì sửa ở đây rồi khởi động lại server.
COMPANY_NAME="Công Ty TNHH DTSOFTWARE"
# Dùng key của project có bật billing và giới hạn quota; không commit key thật
GEMINI_API_KEY=""
# Tên model Gemini; không đặt thì dùng gemini-3.5-flash (src/config/env.js)
GEMINI_MODEL="gemini-3.5-flash"
# Chế độ phân tích CV / JD: hybrid = rule + Gemini (mặc định), rule = chỉ rule, không gọi Gemini
NLP_MODE=hybrid
MAIL_USER="tai-khoan-gui-thu@gmail.com"
MAIL_APP_PASSWORD="abcd efgh ijkl mnop"
MAIL_FROM_NAME="CVMatch Tuyển dụng"
FRONTEND_URL="http://localhost:5173"
# Origin frontend được gọi API, nhiều origin cách nhau bởi dấu phẩy
CORS_ORIGIN="http://localhost:5173"
